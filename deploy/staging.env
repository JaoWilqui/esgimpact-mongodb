# Configuração NÃO sensível do ambiente de STAGING.
# Segredos (MONGO_ROOT_PASSWORD, JWT_KEY) vêm do GitHub Environment "staging".
# O nome do banco e o mesmo nos dois ambientes: o isolamento vem de
# containers, volumes e rede separados (projetos Compose distintos).
ASPNETCORE_ENVIRONMENT=Staging
API_PORT=9081
MONGO_ROOT_USER=esgadmin
MONGO_DATABASE=esgimpact
JWT_EXPIRY_MINUTES=120
API_CPUS=0.5
API_MEMORY=384M
